{
  "expo": {
    "name": "Nissali",
    "slug": "nissali",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nissali",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FCF8F6",
    "primaryColor": "#7A1F35",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.nissali",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["audio"]
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "app.nissali",
      "adaptiveIcon": {
        "backgroundColor": "#7A1F35",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FCF8F6"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nissali utilise ta position pour calculer les horaires de prière et la direction de la qibla."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7A1F35",
          "sounds": [
            "./assets/sounds/adhan_a1_30.caf",
            "./assets/sounds/adhan_a2_30.caf",
            "./assets/sounds/adhan_a4_30.caf",
            "./assets/sounds/adhan_a7_30.caf",
            "./assets/sounds/adhan_a9_30.caf",
            "./assets/sounds/adhan_a11_30.caf",
            "./assets/sounds/adhan_a1.mp3",
            "./assets/sounds/adhan_a2.mp3",
            "./assets/sounds/adhan_a4.mp3",
            "./assets/sounds/adhan_a7.mp3",
            "./assets/sounds/adhan_a11.mp3",
            "./assets/sounds/adhan_full.mp3",
            "./assets/sounds/adhan_short.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nissali accède à tes photos pour ta photo de profil professionnelle."
        }
      ],
      "expo-audio",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7a2e397c-d8f2-43e3-8de6-29ddd183db14"
      }
    },
    "owner": "nissali",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7a2e397c-d8f2-43e3-8de6-29ddd183db14"
    }
  }
}
