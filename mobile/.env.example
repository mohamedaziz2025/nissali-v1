# URL de l'API. Laisser vide en développement : l'app utilise automatiquement
# l'adresse IP de l'ordinateur qui lance Expo (port 4000).
# Exemple production : EXPO_PUBLIC_API_URL=https://api.nissali.fr/api
EXPO_PUBLIC_API_URL=

# Connexion Google (3.1) : identifiant client OAuth « Web ». Vide = bouton Google masqué.
# Doit aussi être déclaré côté API dans GOOGLE_CLIENT_IDS (backend/.env).
# Rebuild obligatoire après modification (EXPO_PUBLIC_* est intégré au bundle).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS uniquement : identifiant client OAuth « iOS » (et son URL scheme dans app.json).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
