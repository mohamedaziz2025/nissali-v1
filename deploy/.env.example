# Copier en deploy/.env sur le serveur (chmod 600). Ne jamais committer.
NODE_ENV=production
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire
PUBLIC_API_URL=http://72.62.71.97:8101
CORS_ORIGINS=http://72.62.71.97:8100
# Pas de HTTPS sur l'IP : cookie non « secure ». Passer à true derrière un domaine en HTTPS.
COOKIE_SECURE=false
# auto : codes renvoyés à l'app uniquement pour les comptes de démo et les canaux sans fournisseur.
DEV_EXPOSE_CODES=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nissali <no-reply@nissali.app>"
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, mot de passe d'application ; MAIL_FROM doit être l'adresse du compte.
SMS_PROVIDER=console
SEED_ADMIN_EMAIL=admin@nissali.app
SEED_ADMIN_PASSWORD=Nissali2026!
# Jeton d'accès Expo (compte propriétaire du projet)
EXPO_TOKEN=
