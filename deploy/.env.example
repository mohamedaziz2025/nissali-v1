# Copier en deploy/.env sur le serveur (chmod 600). Ne jamais committer.
# Valeurs du déploiement en domaine + HTTPS (nginx du VPS -> conteneur nginx :33000).
# Mode IP sans domaine (docker-compose.yml) : PUBLIC_API_URL et CORS_ORIGINS en
# http://<IP>:8101 et http://<IP>:8100, APP_URL en http://<IP>:8100, COOKIE_SECURE=false.
NODE_ENV=production
# Obligatoire : chaîne longue et aléatoire (openssl rand -base64 48).
JWT_SECRET=
PUBLIC_API_URL=https://api.nissali.fr
CORS_ORIGINS=https://nissali.fr
# URL de l'espace web : retour après un paiement Stripe.
APP_URL=https://nissali.fr
# HTTPS : sans cette valeur, le cookie de session est envoyé en clair.
COOKIE_SECURE=true
# auto : codes renvoyés à l'app uniquement pour les comptes de démo et les canaux sans fournisseur.
DEV_EXPOSE_CODES=auto
DEFAULT_COUNTRY_CODE=33

# --- Envoi des codes OTP (obligatoire en production) ---
# Sans SMTP_HOST, les codes ne s'affichent que dans le terminal de l'API : personne ne peut se connecter.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nissali <no-reply@nissali.app>"
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, mot de passe d'application ; MAIL_FROM doit être l'adresse du compte.

# SMS : console | twilio | brevo. « console » n'envoie rien, ne sert qu'au développement.
SMS_PROVIDER=console
SMS_SENDER=Nissali
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
BREVO_API_KEY=

# --- Notifications Web Push (facultatif) : npm --prefix backend run vapid ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@nissali.fr

# --- Paiement des abonnements praticiennes (Stripe) ---
# Vide = paiement en ligne coupé, l'équipe confirme les règlements manuellement.
# Webhook à pointer vers : https://api.nissali.fr/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur

# --- Mosquées partenaires (Mawaqit) : synchronise la Jumu'a chaque nuit ---
MAWAQIT_API_TOKEN=

# --- Seed (première installation) ---
# Choisir ici : le seed est la seule fois où ce mot de passe est lu (il ne réécrit pas un compte existant).
SEED_ADMIN_EMAIL=admin@nissali.app
SEED_ADMIN_PASSWORD=

# --- Jeton d'accès Expo (uniquement pour le compose de développement avec Metro) ---
EXPO_TOKEN=
