{
  "name": "nissali-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API Nissali — cycle, prières, jeûnes, santé",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:local": "node --env-file-if-exists=.env scripts/local-mongo.js",
    "seed": "node --env-file-if-exists=.env src/seed/seed.js",
    "review:account": "node --env-file-if-exists=.env src/seed/review-account.js",
    "vapid": "node scripts/generate-vapid.js",
    "fix:urls": "node --env-file-if-exists=.env src/seed/fixUploadUrls.js",
    "test": "node --test tests/*.test.js",
    "translate:content": "node --env-file-if-exists=.env scripts/translate-content.js"
  },
  "dependencies": {
    "adhan": "^4.4.6",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "mongoose": "^8.24.5",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.1",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
