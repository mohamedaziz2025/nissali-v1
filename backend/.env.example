# --- Serveur ---
PORT=4000
NODE_ENV=development
# Obligatoire en production (chaîne longue et aléatoire)
JWT_SECRET=change-moi-par-une-longue-chaine-aleatoire
# Apps web autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:3001
# URL publique de l'API (pour les photos des praticiennes), ex. https://api.nissali.app
PUBLIC_API_URL=

# --- MongoDB ---
# Local : `npm run db:local` lance un MongoDB sans installation sur 27017
MONGODB_URI=mongodb://127.0.0.1:27017/nissali

# --- Codes OTP ---
# Codes OTP renvoyés à l'app : true (toujours), false (jamais), auto (seulement si le code ne peut pas
# être livré — pas de SMTP / pas de fournisseur SMS — ou pour les comptes de démo DEMO_IDENTIFIERS).
DEV_EXPOSE_CODES=true
DEFAULT_COUNTRY_CODE=33

# E-mail (SMTP) : Brevo, Gmail, OVH… Sans SMTP_HOST, les e-mails sont affichés dans la console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nissali <no-reply@nissali.app>"
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, mot de passe d'application ; MAIL_FROM doit être l'adresse du compte.

# SMS : console | twilio | brevo
SMS_PROVIDER=console
SMS_SENDER=Nissali
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
BREVO_API_KEY=

# --- Notifications Web Push (facultatif) : `npm run vapid` ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:nissali@gmail.com

# --- Divers ---
ALADHAN_BASE_URL=https://api.aladhan.com/v1
ENABLE_JOBS=true
UPLOAD_DIR=uploads

# --- Seed ---
SEED_ADMIN_EMAIL=admin@nissali.app
SEED_ADMIN_PASSWORD=choisis-un-mot-de-passe-solide
