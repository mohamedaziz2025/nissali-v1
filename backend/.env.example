# --- Serveur ---
PORT=4000
NODE_ENV=development
# Obligatoire en production (chaîne longue et aléatoire)
JWT_SECRET=change-moi-par-une-longue-chaine-aleatoire
# Chiffrement des notes personnelles (RG-35). Facultatif : à défaut, dérivé de JWT_SECRET.
# Ne jamais changer une fois des notes enregistrées (elles deviendraient illisibles).
NOTES_KEY=
# Apps web autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:3001
# URL de l'espace web (back-office + espace pro) : sert de retour après un paiement Stripe.
APP_URL=http://localhost:3001
# URL publique de l'API (pour les photos des praticiennes), ex. https://api.nissali.app
PUBLIC_API_URL=

# --- MongoDB ---
# Local : `npm run db:local` lance un MongoDB sans installation sur 27017
MONGODB_URI=mongodb://127.0.0.1:27017/nissali

# --- Codes de vérification (envoyés uniquement par e-mail) ---
# En local, le code est aussi écrit dans les logs de l'API (jamais en production) ; false pour le couper.
DEV_EXPOSE_CODES=true
DEFAULT_COUNTRY_CODE=33

# E-mail (SMTP). Sans SMTP_HOST, les e-mails sont affichés dans la console. OVH : ssl0.ovh.net, port 465 (SSL/TLS).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=8X93tr8XR6Q0.
MAIL_FROM="Nissali <contact@nissali.fr>"


# --- Notifications Web Push (facultatif) : `npm run vapid` ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@nissali.fr

# --- Divers ---
ALADHAN_BASE_URL=https://api.aladhan.com/v1
ENABLE_JOBS=true
UPLOAD_DIR=uploads

# --- Paiement des abonnements praticiennes (Stripe) ---
# Laisser les clés vides : le paiement en ligne est coupé et l'équipe confirme les règlements
# manuellement depuis le back-office (formulaire « Paiements à confirmer »), comme avant.
# Clés de test : https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Devise des formules (code ISO 4217 minuscule). Les prix du back-office sont en euros.
STRIPE_CURRENCY=eur

# --- Seed ---
SEED_ADMIN_EMAIL=admin@nissali.app
SEED_ADMIN_PASSWORD=choisis-un-mot-de-passe-solide

# Mawaqit (API partenaire) : synchronise chaque nuit la Jumu'a des mosquées partenaires
MAWAQIT_API_TOKEN=
